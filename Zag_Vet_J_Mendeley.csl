<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text">
  <info>
    <title>Zag Vet J</title>
    <title-short>Zag Vet J</title-short>
    <id>http://www.zotero.org/styles/zag-vet-j</id>
    <link href="http://www.zotero.org/styles/zag-vet-j" rel="self"/>
    <updated>2026-09-22T00:00:00+03:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " delimiter-precedes-last="always" and="text"/>
      <et-al font-style="normal"/>
    </names>
  </macro>
  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="article-journal">
    <group delimiter=". ">
      <text macro="author"/>
      <text variable="title"/>
      <group delimiter=" ">
        <text variable="container-title" form="short"/>
        <date variable="issued"><date-part name="year"/></date>
        <text variable="volume"/>
        <text variable="issue" prefix="(" suffix=")"/>
        <text variable="page" prefix=":"/>
      </group>
    </group>
  </macro>
  <citation collapse="citation-number" after-collapse-delimiter=",">
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <choose>
        <if type="article-journal" match="any">
          <text macro="article-journal"/>
        </if>
        <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
          <text macro="author" suffix=". "/>
          <text variable="title" suffix=". "/>
          <text variable="container-title" suffix=". "/>
          <text variable="publisher-place" suffix=": "/>
          <text variable="publisher" suffix="; "/>
          <date variable="issued"><date-part name="year"/></date>
          <text variable="page" prefix=":"/>
        </else-if>
        <else>
          <text macro="author" suffix=". "/>
          <text variable="title" suffix=". "/>
          <text variable="container-title" suffix=". "/>
          <date variable="issued"><date-part name="year" suffix="."/></date>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
